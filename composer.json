{
    "name": "croustibat/filament-jobs-monitor",
    "description": "Background Jobs monitoring like Horizon for all drivers for FilamentPHP",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "jobs",
        "queue",
        "monitor",
        "background-jobs"
    ],
    "homepage": "https://github.com/ultraviolettes/filament-jobs-monitor",
    "license": "MIT",
    "authors": [
        {
            "name": "Baptiste",
            "email": "baptiste@dark-matter.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.13.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.14|^10.10|^11.0",
        "pestphp/pest": "^3.8|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Croustibat\\FilamentJobsMonitor\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Croustibat\\FilamentJobsMonitor\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Croustibat\\FilamentJobsMonitor\\FilamentJobsMonitorServiceProvider",
                "Croustibat\\FilamentJobsMonitor\\QueueMonitorProvider"
            ],
            "aliases": {
                "QueueMonitor": "Croustibat\\FilamentJobsMonitor\\QueueMonitorProvider\\Facade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
