{
    "private": true,
    "scripts": {
        "dev:styles": "npx tailwindcss -i resources/css/plugin.css -o resources/dist/filament-jobs-monitor.css --postcss --watch",
        "dev:scripts": "esbuild resources/js/plugin.js --bundle --sourcemap=inline --outfile=resources/dist/filament-jobs-monitor.js --watch",
        "build:styles": "npx tailwindcss -i resources/css/plugin.css -o resources/dist/filament-jobs-monitor.css --postcss --minify && npm run purge && npm run layer",
        "build:scripts": "esbuild resources/js/plugin.js --bundle --minify --outfile=resources/dist/filament-jobs-monitor.js",
        "purge": "filament-purge -i resources/dist/filament-jobs-monitor.css -o resources/dist/filament-jobs-monitor.css",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*",
        "layer": "node -e \"const fs=require('fs'),f='resources/dist/filament-jobs-monitor.css',c=fs.readFileSync(f,'utf8').trim();if(c&&!c.startsWith('@layer components{'))fs.writeFileSync(f,'@layer components{'+c+'}')\""
    },
    "devDependencies": {
        "@awcodes/filament-plugin-purge": "^1.0.2",
        "autoprefixer": "^10.4.7",
        "esbuild": "^0.8.57",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.14",
        "prettier": "^2.7.1",
        "prettier-plugin-tailwindcss": "^0.1.13",
        "tailwindcss": "^3.1.6"
    }
}
